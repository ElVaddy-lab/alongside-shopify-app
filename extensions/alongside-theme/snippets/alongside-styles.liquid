{%- comment -%}
  Alongside styles, inlined with the block / embed markup instead of a
  "stylesheet" in the block schema: Shopify puts schema stylesheets in <head>
  as a render-blocking request (Lighthouse: ~0.8 s on throttled mobile).
  Small enough to repeat if both the block and the cart embed are on a page.
{%- endcomment -%}
<style>
/* Alongside: inherits the theme's fonts and colours; only layout and states here. */
.alongside {
  margin-block: 1.5em;
  padding-block-start: 1em;
  border-block-start: 1px solid color-mix(in srgb, currentColor 20%, transparent);
}

.alongside-cart .alongside {
  margin-block: 1em 0;
}

.alongside__heading {
  margin: 0 0 0.75em;
  font: inherit;
  font-size: 1em;
  font-weight: 600;
  letter-spacing: inherit;
  text-transform: inherit;
}

.alongside__list {
  display: grid;
  gap: 0.75em;
  margin: 0;
  padding: 0;
  list-style: none;
}

.alongside__item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.75em;
  align-items: start;
}

.alongside__image {
  display: block;
  width: 80px;
  height: 80px;
  object-fit: cover;
}

.alongside__form {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.25em 0.75em;
  align-items: center;
  margin: 0;
}

.alongside__title {
  grid-column: 1;
  color: inherit;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

.alongside__price,
.alongside__badge {
  grid-column: 1;
  margin: 0;
}

.alongside__compare {
  margin-inline-end: 0.35em;
}

.alongside__sale {
  font-weight: 600;
}

.alongside__badge {
  font-size: 0.875em;
}

.alongside__label {
  grid-column: 1;
  font-size: 0.875em;
}

.alongside__select {
  grid-column: 1;
  min-height: 2.75em;
  max-width: 100%;
  padding-inline: 0.5em;
  font: inherit;
  color: inherit;
  background: transparent;
  border: 1px solid currentColor;
  border-radius: 0;
}

.alongside__button {
  grid-column: 2;
  grid-row: 1 / span 3;
  min-width: 2.75em;
  min-height: 2.75em;
  padding-inline: 1em;
  font: inherit;
  font-weight: 600;
  color: inherit;
  background: transparent;
  border: 1px solid currentColor;
  border-radius: 0;
  cursor: pointer;
}

.alongside__button:hover {
  background: color-mix(in srgb, currentColor 8%, transparent);
}

.alongside__button:focus-visible,
.alongside__select:focus-visible,
.alongside__title:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.alongside__button[aria-busy="true"] {
  cursor: progress;
  opacity: 0.6;
}

.alongside__status:empty {
  display: none;
}

.alongside__status {
  margin: 0.5em 0 0;
  font-size: 0.875em;
}

.alongside__status--error {
  font-weight: 600;
}

.alongside__visually-hidden {
  position: absolute !important;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.alongside__editor-note {
  padding: 0.75em;
  border: 1px dashed currentColor;
  font-size: 0.875em;
}

@media (prefers-reduced-motion: no-preference) {
  .alongside__button {
    transition: background-color 0.15s ease;
  }
}
</style>
